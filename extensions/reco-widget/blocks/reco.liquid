{% comment %}
  Boko AI Recommendations — single "Recommended" rail (app/LLM-powered).
  Calls your hosted app at block.settings.proxy_url (e.g. https://<repl>.replit.dev/recommend).
  Design (font family / size / heading size / use-theme-fonts) is set in the theme editor.
  Install: Edit code → Sections → Add a new section "boko-recommendations" → paste → Save
           → Customize → Add section → "AI Recommendations".
{% endcomment %}
{%- liquid
  assign font_css = "TAN-MONCHERI"
  case block.settings.font_family
    when 'poppins'
      assign font_css = "'Poppins',sans-serif"
    when 'helvetica'
      assign font_css = "Helvetica,Arial,sans-serif"
    when 'georgia'
      assign font_css = "Georgia,'Times New Roman',serif"
    when 'system'
      assign font_css = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif"
  endcase
  if block.settings.use_theme_fonts
    assign font_css = "inherit"
  endif
  assign container_css = "max-width:1240px;margin:40px auto;padding:0 16px"
  if block.settings.full_width
    assign container_css = "width:100vw;max-width:100vw;margin:40px 0;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw);padding:0"
  endif
  assign img_fit = "cover"
  if block.settings.image_fit == "contain"
    assign img_fit = "contain"
  endif
-%}
<style>
#boko-reco-{{ block.id }}{
  --reco-font: {{ font_css }};
  --reco-title: {{ block.settings.heading_size }}px;
  --reco-body: {{ block.settings.body_size }}px;
  --reco-ls: {{ block.settings.heading_spacing }}px;
  --ink:#2b2b2b;--muted:#8a8a8a;--line:#e6e6e6;--badge:#3f8f5f;
  font-family:var(--reco-font);color:var(--ink);{{ container_css }}}
#boko-reco-{{ block.id }} *{box-sizing:border-box}
#boko-reco-{{ block.id }} .boko-reco__title{text-align:center;font-weight:{{ block.settings.heading_weight }};font-size:var(--reco-title);letter-spacing:var(--reco-ls);text-transform:uppercase;margin:0 0 30px}
#boko-reco-{{ block.id }} .boko-reco__grid{display:grid;gap:{{ block.settings.grid_gap }}px}
#boko-reco-{{ block.id }} .boko-reco__loading{grid-column:1/-1;text-align:center;color:var(--muted);padding:24px}
#boko-reco-{{ block.id }} .boko-reco__card{position:relative;display:flex;flex-direction:column;background:#fff}
#boko-reco-{{ block.id }} .boko-reco__imgwrap{position:relative;aspect-ratio:3/4.1;overflow:hidden;background:#f3f1ee}
#boko-reco-{{ block.id }} .boko-reco__imgwrap img{width:100%;height:100%;object-fit:{{ img_fit }};display:block}
#boko-reco-{{ block.id }} .boko-reco__bsel{position:absolute;top:10px;right:10px;z-index:3;display:flex;align-items:center;gap:5px;background:rgba(255,255,255,.92);border:1px solid var(--line);border-radius:99px;padding:3px 9px;font-size:11px;cursor:pointer;opacity:1;transition:opacity .2s}
#boko-reco-{{ block.id }} .boko-reco__bsel input{accent-color:var(--badge);margin:0}
#boko-reco-{{ block.id }} .boko-reco__atc{position:absolute;left:12px;right:12px;bottom:12px;z-index:2;border:none;background:#1f1f1f;color:#fff;font:inherit;font-size:calc(var(--reco-body) - 2px);letter-spacing:1.5px;text-transform:uppercase;padding:12px;cursor:pointer;opacity:0;transform:translateY(6px);transition:.2s}
#boko-reco-{{ block.id }} .boko-reco__card:hover .boko-reco__atc{opacity:1;transform:translateY(0)}
#boko-reco-{{ block.id }} .boko-reco__atc.is-added{background:var(--badge)}
#boko-reco-{{ block.id }} .boko-reco__cbody{padding:14px 6px 0;text-align:center;display:flex;flex-direction:column;align-items:center;gap:7px}
#boko-reco-{{ block.id }} .boko-reco__vendor{font-size:calc(var(--reco-body) - 3px);color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
#boko-reco-{{ block.id }} .boko-reco__ctitle{font-size:var(--reco-body);letter-spacing:1.2px;text-transform:uppercase;font-weight:400}
#boko-reco-{{ block.id }} .boko-reco__price{font-size:calc(var(--reco-body) + 2px)}
#boko-reco-{{ block.id }} .boko-reco__bar{position:fixed;left:0;right:0;bottom:0;background:#1f1f1f;color:#fff;padding:13px 22px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;transform:translateY(120%);transition:transform .25s;z-index:9999;font-family:var(--reco-font)}
#boko-reco-{{ block.id }} .boko-reco__bar.is-show{transform:translateY(0)}
#boko-reco-{{ block.id }} .boko-reco__bthumbs{display:flex}
#boko-reco-{{ block.id }} .boko-reco__bthumbs img{width:40px;height:40px;border-radius:4px;object-fit:cover;border:2px solid #1f1f1f;margin-left:-10px}
#boko-reco-{{ block.id }} .boko-reco__bthumbs img:first-child{margin-left:0}
#boko-reco-{{ block.id }} .boko-reco__btext b{font-size:14px}#boko-reco-{{ block.id }} .boko-reco__btext span{display:block;font-size:12px;color:#bdbdbd}
#boko-reco-{{ block.id }} .boko-reco__save{color:#7fd0a1}
#boko-reco-{{ block.id }} .boko-reco__bspacer{flex:1}
#boko-reco-{{ block.id }} .boko-reco__btotal{font-size:20px}#boko-reco-{{ block.id }} .boko-reco__btotal small{font-size:12px;color:#9a9a9a;text-decoration:line-through;margin-right:8px}
#boko-reco-{{ block.id }} .boko-reco__badd{border:none;background:#fff;color:#1f1f1f;font:inherit;font-size:13px;letter-spacing:1.5px;text-transform:uppercase;padding:12px 22px;cursor:pointer}
#boko-reco-{{ block.id }} .boko-reco__bclear{background:transparent;border:1px solid #444;color:#ddd;padding:11px 14px;font:inherit;font-size:12px;letter-spacing:1px;text-transform:uppercase;cursor:pointer}
@media(max-width:600px){#boko-reco-{{ block.id }} .boko-reco__grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
#boko-reco-{{ block.id }} .boko-reco__opts{display:flex;flex-direction:column;gap:6px;margin-top:6px;width:100%}
#boko-reco-{{ block.id }} .boko-reco__opt{display:flex;flex-wrap:wrap;align-items:center;gap:5px;justify-content:center}
#boko-reco-{{ block.id }} .boko-reco__optlabel{font-size:calc(var(--reco-body) - 3px);color:var(--muted);text-transform:uppercase;letter-spacing:.4px}
#boko-reco-{{ block.id }} .boko-reco__sw{border:1px solid var(--line);background:#fff;color:var(--ink);font:inherit;font-size:calc(var(--reco-body) - 2px);padding:4px 9px;border-radius:4px;cursor:pointer;line-height:1}
#boko-reco-{{ block.id }} .boko-reco__sw:hover{border-color:var(--ink)}
#boko-reco-{{ block.id }} .boko-reco__sw.is-sel{background:#1f1f1f;color:#fff;border-color:#1f1f1f}
#boko-reco-{{ block.id }} .boko-reco__sw.is-oos{opacity:.4;text-decoration:line-through;cursor:not-allowed}
#boko-reco-{{ block.id }} .boko-reco__nav{display:flex;align-items:center;justify-content:center;gap:14px;margin-top:18px}
#boko-reco-{{ block.id }} .boko-reco__nav-btn{width:38px;height:38px;border:1px solid var(--line);background:#fff;border-radius:50%;cursor:pointer;font-size:22px;line-height:1;color:var(--ink);display:flex;align-items:center;justify-content:center;padding:0;flex-shrink:0;transition:border-color .15s}
#boko-reco-{{ block.id }} .boko-reco__nav-btn:hover{border-color:var(--ink)}
#boko-reco-{{ block.id }} .boko-reco__dots{display:flex;gap:7px;align-items:center}
#boko-reco-{{ block.id }} .boko-reco__nav-dot{width:8px;height:8px;border-radius:50%;background:var(--line);border:none;padding:0;cursor:pointer;transition:background .2s}
#boko-reco-{{ block.id }} .boko-reco__nav-dot.on{background:var(--ink)}
</style>
<div id="boko-reco-{{ block.id }}" class="boko-reco" data-boko-reco
  data-proxy="{{ block.settings.proxy_url }}"
  data-per-row="{{ block.settings.per_row }}"
  data-limit="{{ block.settings.limit }}"
  data-days="{{ block.settings.days }}"
  data-bundle-discount="{{ block.settings.bundle_discount }}"
  {% if template contains 'product' %}data-anchor="{{ product.id }}" data-anchor-type="{{ product.type | escape }}" data-anchor-title="{{ product.title | escape }}" data-anchor-tags="{{ product.tags | join: ',' | escape }}" data-anchor-price="{{ product.price | divided_by: 100.0 }}"{% endif %}>
  <h2 class="boko-reco__title">{{ block.settings.title }}</h2>
  <div class="boko-reco__grid" data-reco-grid></div>
</div>
<script>
(function(){
  function el(h){var d=document.createElement("div");d.innerHTML=h.trim();return d.firstChild;}
  function vnum(g){var m=String(g).match(/(\d+)$/);return m?m[1]:g;}
  function init(root){
    var proxy=root.getAttribute("data-proxy")||"/apps/reco/recommend";
    var perRow=parseInt(root.getAttribute("data-per-row")||"4",10);
    var limit=parseInt(root.getAttribute("data-limit")||"8",10);
    var days=root.getAttribute("data-days")||"";
    var discount=parseFloat(root.getAttribute("data-bundle-discount")||"0");
    var anchor=root.getAttribute("data-anchor")||"";
    var aType=root.getAttribute("data-anchor-type")||"";
    var aTitle=root.getAttribute("data-anchor-title")||"";
    var aTags=root.getAttribute("data-anchor-tags")||"";
    var aPrice=root.getAttribute("data-anchor-price")||"";
    var grid=root.querySelector("[data-reco-grid]");
    var bundle=[],ITEMS={},bar;
    function money(n){return "$"+Number(n).toFixed(2);}
    function toast(count){var t=document.getElementById("boko-toast");if(!t){t=el("<div id='boko-toast' style=\"position:fixed;right:18px;bottom:18px;z-index:100000;background:#1f1f1f;color:#fff;padding:14px 18px;border-radius:10px;font:500 14px/1.2 'Jost',-apple-system,sans-serif;box-shadow:0 6px 24px rgba(0,0,0,.25);display:flex;gap:14px;align-items:center;transform:translateY(160%);transition:transform .25s\"></div>");document.body.appendChild(t);}t.innerHTML="<span>✓ Added to cart</span><a href='/cart' style='color:#BFFC00;text-decoration:none;font-size:13px'>View cart →</a>";t.style.transform="translateY(0)";clearTimeout(t._t);t._t=setTimeout(function(){t.style.transform="translateY(160%)";},3200);}
    function cartNotify(count){try{document.querySelectorAll(".cart-link__count,.cart-count-bubble,.cart-count,[data-cart-count],#CartCount,.cart-link__bubble,.cart-count-number,[data-cart-item-count],.cart-counter,.cart__count").forEach(function(e){var n=e.querySelector("span")||e;if(/^\s*\d+\s*$/.test(n.textContent||""))n.textContent=count;});}catch(e){}["cart:refresh","cart:updated","cart:change","ajaxCart:afterCartLoad"].forEach(function(ev){document.dispatchEvent(new CustomEvent(ev));});}
    function refreshCart(){return fetch("/cart.js",{headers:{Accept:"application/json"}}).then(function(r){return r.json();}).then(function(c){cartNotify(c.item_count);}).catch(function(){cartNotify(0);});}
    function getSections(){var cd=document.querySelector("cart-drawer");return (cd&&cd.getSectionsToRender)?cd.getSectionsToRender().map(function(s){return s.id;}):null;}
    function showCart(json){var cd=document.querySelector("cart-drawer");if(cd&&typeof cd.renderContents==="function"&&json&&json.sections&&json.sections["cart-drawer"]){try{cd.renderContents(json);cd.classList.remove("is-empty");var inner=document.querySelector("#CartDrawer");if(inner)inner.classList.remove("is-empty");return;}catch(e){}}refreshCart();}
    function getItems(){
      var url=proxy+"?type=recommended&limit="+limit+(anchor?"&anchor="+encodeURIComponent(anchor):"")+(aType?"&atype="+encodeURIComponent(aType):"")+(aTitle?"&atitle="+encodeURIComponent(aTitle):"")+(aTags?"&atags="+encodeURIComponent(aTags):"")+(aPrice?"&aprice="+encodeURIComponent(aPrice):"")+(days?"&days="+encodeURIComponent(days):"");
      return fetch(url,{headers:{Accept:"application/json"}}).then(function(r){return r.json();}).then(function(d){return d.items||[];}).catch(function(){return [];});
    }
    function variantFor(p,sel){for(var i=0;i<p.variants.length;i++){var v=p.variants[i],ok=true;for(var k=0;k<sel.length;k++){if(sel[k]!=null&&v.options[k]!==sel[k]){ok=false;break;}}if(ok)return v;}return null;}
    function firstAvail(p){for(var i=0;i<p.variants.length;i++){if(p.variants[i].available)return p.variants[i];}return p.variants[0];}
    function valAvail(p,oi,val,sel){for(var i=0;i<p.variants.length;i++){var v=p.variants[i];if(!v.available)continue;if(v.options[oi]!==val)continue;var ok=true;for(var k=0;k<sel.length;k++){if(k!==oi&&sel[k]!=null&&v.options[k]!==sel[k]){ok=false;break;}}if(ok)return true;}return false;}
    function card(p){
      var inB=bundle.indexOf(p.variantId)>=0;
      var url=p.handle?("/products/"+p.handle):null;
      var imgInner=(p.img?"<img loading='lazy' src='"+p.img+"' alt=''>":"");
      var imgHtml=url?("<a class='boko-reco__imglink' href='"+url+"' style='position:absolute;inset:0;display:block'>"+imgInner+"</a>"):imgInner;
      var titleHtml=url?("<a href='"+url+"' style='color:inherit;text-decoration:none'>"+p.title+"</a>"):p.title;
      var c=el("<div class='boko-reco__card'><div class='boko-reco__imgwrap'><label class='boko-reco__bsel'><input type='checkbox' "+(inB?"checked":"")+"> Bundle</label>"+imgHtml+"<button class='boko-reco__atc'>Add to cart</button></div><div class='boko-reco__cbody'><div class='boko-reco__vendor'>"+(p.vendor||"")+"</div><div class='boko-reco__ctitle'>"+titleHtml+"</div><div class='boko-reco__price'>"+money(p.price)+"</div><div class='boko-reco__opts'></div></div></div>");
      var priceEl=c.querySelector(".boko-reco__price"),atc=c.querySelector(".boko-reco__atc"),optsEl=c.querySelector(".boko-reco__opts");
      var vid=p.variantId;
      var hasV=p.options&&p.options.length&&p.variants&&p.variants.length>1;
      if(hasV){
        var sel=p.options.map(function(){return null;});
        var dv=firstAvail(p); if(dv){sel=dv.options.slice();vid=dv.id;priceEl.textContent=money(dv.price);}
        var draw=function(){
          optsEl.innerHTML="";
          p.options.forEach(function(opt,oi){
            var row=document.createElement("div");row.className="boko-reco__opt";
            var lab=document.createElement("span");lab.className="boko-reco__optlabel";lab.textContent=opt.name;row.appendChild(lab);
            opt.values.forEach(function(val){
              var b=document.createElement("button");b.type="button";
              var on=sel[oi]===val,av=valAvail(p,oi,val,sel);
              b.className="boko-reco__sw"+(on?" is-sel":"")+(av?"":" is-oos");
              b.textContent=val;
              b.addEventListener("click",function(){if(!av&&!on)return;sel[oi]=val;var v=variantFor(p,sel);if(v){vid=v.id;priceEl.textContent=money(v.price);atc.disabled=!v.available;atc.textContent=v.available?"Add to cart":"Sold out";}draw();});
              row.appendChild(b);
            });
            optsEl.appendChild(row);
          });
          var cur=variantFor(p,sel); if(cur){atc.disabled=!cur.available;atc.textContent=cur.available?"Add to cart":"Sold out";}
        };
        draw();
      }
      atc.addEventListener("click",function(){if(this.disabled)return;addToCart(vid,this);});
      c.querySelector("input").addEventListener("change",function(){toggleBundle(p);});
      return c;
    }
    function load(){
      var COLS=Math.min(perRow,8);
      grid.style.gridTemplateColumns="repeat("+COLS+",minmax(0,1fr))";
      grid.innerHTML="<div class='boko-reco__loading'>Loading…</div>";
      getItems().then(function(items){
        grid.innerHTML="";
        items=items.filter(function(p){return !!p.variantId;});
        if(!items.length){grid.innerHTML="<div class='boko-reco__loading'>No recommendations yet.</div>";return;}
        var pages=[]; for(var i=0;i<items.length;i+=COLS)pages.push(items.slice(i,i+COLS));
        var page=0;
        var nav=root.querySelector("[data-reco-nav]");
        if(!nav){
          nav=el("<div class='boko-reco__nav' data-reco-nav><button class='boko-reco__nav-btn' data-prev>&#8249;</button><div class='boko-reco__dots' data-dots></div><button class='boko-reco__nav-btn' data-next>&#8250;</button></div>");
          grid.parentNode.insertBefore(nav,grid.nextSibling);
          nav.querySelector("[data-prev]").addEventListener("click",function(){showPage(page-1);});
          nav.querySelector("[data-next]").addEventListener("click",function(){showPage(page+1);});
        }
        function showPage(p){
          page=(p+pages.length)%pages.length;
          grid.innerHTML="";
          pages[page].forEach(function(item){grid.appendChild(card(item));});
          var dotsEl=nav.querySelector("[data-dots]");
          dotsEl.innerHTML=pages.map(function(_,k){return "<button class='boko-reco__nav-dot"+(k===page?" on":"")+"' data-p='"+k+"'></button>";}).join("");
          dotsEl.querySelectorAll("[data-p]").forEach(function(d){d.addEventListener("click",function(){showPage(+d.dataset.p);});});
          nav.style.display=pages.length>1?"flex":"none";
        }
        showPage(0);
      });
    }
    function addToCart(variantId,btn){if(btn)btn.disabled=true;var body={items:[{id:Number(vnum(variantId)),quantity:1,properties:{"_boko_reco":"pdp"}}]};var sec=getSections();if(sec){body.sections=sec;body.sections_url=location.pathname;}fetch("/cart/add.js",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)}).then(function(r){if(!r.ok)return r.json().then(function(e){throw e;});return r.json();}).then(function(json){if(btn){btn.textContent="Added ✓";btn.classList.add("is-added");setTimeout(function(){btn.textContent="Add to cart";btn.classList.remove("is-added");btn.disabled=false;},1600);}showCart(json);}).catch(function(e){if(btn){btn.textContent="Unavailable";setTimeout(function(){btn.textContent="Add to cart";btn.disabled=false;},1600);}console.warn("[boko] add-to-cart failed",e);});}
    function ensureBar(){if(bar)return bar;bar=el("<div class='boko-reco__bar'><div class='boko-reco__bthumbs' data-bt></div><div class='boko-reco__btext'><b data-bc>0 items</b><span data-bs></span></div><div class='boko-reco__bspacer'></div><div class='boko-reco__btotal'><small data-bcomp></small><span data-btt>$0.00</span></div><button class='boko-reco__bclear' data-bclear>Clear</button><button class='boko-reco__badd' data-badd>Add bundle to cart</button></div>");root.appendChild(bar);bar.querySelector("[data-bclear]").addEventListener("click",function(){bundle=[];ITEMS={};renderBundle();load();});bar.querySelector("[data-badd]").addEventListener("click",addBundle);return bar;}
    function toggleBundle(p){var i=bundle.indexOf(p.variantId);if(i>=0){bundle.splice(i,1);delete ITEMS[p.variantId];}else{bundle.push(p.variantId);ITEMS[p.variantId]=p;}renderBundle();}
    function renderBundle(){ensureBar();if(!bundle.length){bar.classList.remove("is-show");return;}var items=bundle.map(function(v){return ITEMS[v];});var sub=items.reduce(function(s,p){return s+Number(p.price);},0);var disc=sub*discount/100;bar.querySelector("[data-bt]").innerHTML=items.slice(0,6).map(function(p){return p.img?"<img src='"+p.img+"' alt=''>":"";}).join("");bar.querySelector("[data-bc]").textContent=items.length+(items.length===1?" item":" items")+" in bundle";bar.querySelector("[data-bs]").innerHTML=discount?"<span class='boko-reco__save'>Save "+money(disc)+" ("+discount+"%)</span>":"";bar.querySelector("[data-bcomp]").textContent=discount?money(sub):"";bar.querySelector("[data-btt]").textContent=money(sub-disc);bar.classList.add("is-show");}
    function addBundle(){if(!bundle.length)return;var items=bundle.map(function(v){return {id:Number(vnum(v)),quantity:1,properties:{"_boko_reco":"pdp"}};});var add=bar&&bar.querySelector("[data-badd]");if(add){add.disabled=true;add.textContent="Adding…";}function done(){if(add){add.disabled=false;add.textContent="Add bundle to cart";}bundle=[];ITEMS={};renderBundle();load();}var body={items:items};var sec=getSections();if(sec){body.sections=sec;body.sections_url=location.pathname;}fetch("/cart/add.js",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)}).then(function(r){if(!r.ok)throw r;return r.json();}).then(function(json){showCart(json);done();}).catch(function(){var seq=Promise.resolve();items.forEach(function(it){seq=seq.then(function(){return fetch("/cart/add.js",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({items:[it]})}).then(function(){}).catch(function(){});});});seq.then(function(){return refreshCart();}).then(done);});}
    load();
  }
  document.querySelectorAll("[data-boko-reco]").forEach(init);
})();
</script>
{% if block.settings.custom_css != blank %}<style>{{ block.settings.custom_css }}</style>{% endif %}

{% schema %}
{
  "name": "AI Recommendations",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "text",
      "id": "days",
      "label": "Show products from (last X days)",
      "default": "90",
      "info": "Only show products published in the last X days. Use 0 for all products."
    },
    {
      "type": "range",
      "id": "per_row",
      "label": "Columns per page (max 8)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "bundle_discount",
      "label": "Bundle discount %",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "proxy_url",
      "label": "App endpoint URL",
      "default": "/apps/reco/recommend",
      "info": "Leave as-is unless you changed the App Proxy subpath."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "checkbox",
      "id": "use_theme_fonts",
      "label": "Use my theme's fonts",
      "default": true
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family (if not using theme fonts)",
      "options": [
        {
          "value": "jost",
          "label": "Jost (modern)"
        },
        {
